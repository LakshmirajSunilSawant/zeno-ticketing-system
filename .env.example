# WHY a committed .example file: it documents every variable the app needs without committing a
# single real secret. Copy to .env for local development.

# Local default is SQLite so the project runs with zero setup.
# Render injects a real Postgres URL, e.g. postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./ticketing.db

# MUST be overridden in any deployed environment. Render generates this automatically.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# "*" makes the API callable from any origin. Narrow this to real front-end origins in production.
CORS_ORIGINS=*
RATE_LIMIT=100/minute

# development = human-readable logs; production = JSON logs
ENV=development

# Seed credentials (seed.py). Override these on the deployed instance.
ADMIN_EMAIL=admin@zeno.dev
ADMIN_PASSWORD=admin12345
DEMO_EMAIL=demo@zeno.dev
DEMO_PASSWORD=demo12345
