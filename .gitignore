# WHY: secrets and local state must never reach GitHub - the .env and *.db rules are the
# important ones; the rest is noise reduction.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
*.db
*.db-wal
*.db-shm
.DS_Store
.idea/
.vscode/

# Swagger UI assets are downloaded during the Docker build, not committed (1.5MB of vendor JS).
app/static/
